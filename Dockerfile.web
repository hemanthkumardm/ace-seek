# Dockerfile.web — single container for AIC web UI + Pandoc + TeX
# Used by docker-compose on Oracle (or any VPS).
#
# Build:  docker build -f Dockerfile.web -t aic .
# Run:    docker run -d --name ace-compiler -p 3000:3000 aic

FROM --platform=linux/amd64 pandoc/latex:latest

USER root

# Node (Next.js), Python (preprocess), fonts, docker client for OpenROAD
RUN apk add --no-cache \
      nodejs \
      npm \
      python3 \
      bash \
      font-dejavu \
      fontconfig \
      ttf-freefont \
      docker-cli \
      tini \
    && fc-cache -f \
    && node --version \
    && npm --version \
    && pandoc --version | head -1

# TeX Live from base image is already on PATH via pandoc/latex
WORKDIR /app

# CLI + scripts
COPY bin/ ./bin/
COPY scripts/ ./scripts/
RUN mkdir -p ./templates
RUN chmod +x ./bin/aic ./bin/aic-preprocess ./scripts/*.sh 2>/dev/null || chmod +x ./bin/aic ./bin/aic-preprocess || true

# Web app deps first (better layer cache)
COPY web/package.json web/package-lock.json* ./web/
WORKDIR /app/web
RUN npm ci || npm install

# Rest of web sources
COPY web/ ./

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV AIC_ROOT=/app
# All compiles use TeX inside this container (no nested docker)
ENV AIC_FORCE_LOCAL=1
ENV AIC_BACKEND_DEFAULT=local
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# Clerk authentication environment variables
ENV NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_c3VwZXItY2F0dGxlLTc5LmNsZXJrLmFjY291bnRzLmRldiQ
ENV CLERK_SECRET_KEY=sk_test_321ystwxZHxC2dOk5VH2XF8B9a80lC19uYzbBkQ74g

# Baked into the Next build for command-center → product links
ARG NEXT_PUBLIC_SITE_URL=https://www.ace-seek.com
ARG NEXT_PUBLIC_DOC_URL=https://tools.ace-seek.com
ARG NEXT_PUBLIC_TIMING_URL=https://vlsi.ace-seek.com
ARG NEXT_PUBLIC_SCRIPTS_URL=https://tools.ace-seek.com
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_DOC_URL=$NEXT_PUBLIC_DOC_URL
ENV NEXT_PUBLIC_TIMING_URL=$NEXT_PUBLIC_TIMING_URL
ENV NEXT_PUBLIC_SCRIPTS_URL=$NEXT_PUBLIC_SCRIPTS_URL

RUN npm run build

EXPOSE 3000

# tini reaps zombies from TeX child processes
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["npm", "run", "start", "--", "-H", "0.0.0.0", "-p", "3000"]
